# Optional cache locations. RunPod users normally keep these under /workspace.
HF_HOME=/workspace/hf-cache
PIP_CACHE_DIR=/workspace/pip-cache

# Optional Hugging Face read token for private or gated checkpoint repositories.
# HF_TOKEN=hf_your_read_token

# Optional Gradio basic authentication for a publicly exposed RunPod port.
# VLM_USERNAME=researcher
# VLM_PASSWORD=replace-with-a-long-random-password

# Interface configuration.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
POLYP_GATE_THRESHOLD=0.30

# Optional local checkpoint overrides.
# CLASSIFICATION_CHECKPOINT=/absolute/path/to/so400m_classifier_seed42_vision_ema.pt
# SEGMENTATION_CHECKPOINT=/absolute/path/to/seed43_best.pt
